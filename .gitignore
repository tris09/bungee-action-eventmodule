# Dependencies (re-created by "npm install" / "composer install")
node_modules/
server/vendor/

# Secrets – never commit
server/config.php
.env
.env.*

# Runtime data of the contact form (rate limits, logs)
server/storage/*
!server/storage/.gitignore

# OS / editor / logs
.DS_Store
Thumbs.db
desktop.ini
*.log
